// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE / AUTH
// ============================================

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique @db.VarChar(255)
  password_hash String    @db.VarChar(255)
  full_name     String    @db.VarChar(255)
  phone         String?   @db.VarChar(50)
  avatar_url    String?   @db.Text
  is_active     Boolean   @default(true)
  last_login_at DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  staff           Staff?
  sessions        Session[]
  vouchers        Voucher[]       @relation("voucher_issued_by")
  journal_entries JournalEntry[]  @relation("journal_created_by")
  documents       Document[]      @relation("document_uploaded_by")
  calendar_events CalendarEvent[] @relation("calendar_created_by")
   audit_logs      AuditLog[]
  notifications   Notification[]
  user_roles      UserRole[]
  refresh_tokens  RefreshToken[]

  @@index([email])
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  role_permissions RolePermission[]
  user_roles       UserRole[]

  @@map("roles")
}

model UserRole {
  user_id    String @db.Uuid
  role_id    String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@map("user_roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(100)
  description String? @db.Text

  role_permissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       String @db.Uuid
  permission_id String @db.Uuid

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model Session {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @unique @db.VarChar(255)
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model RefreshToken {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  token       String   @unique @db.Text
  expires_at  DateTime @db.Timestamptz(6)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  revoked     Boolean  @default(false)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ============================================
// CUSTOMERS
// ============================================

model Customer {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name            String    @db.VarChar(255)
  email                String?   @db.VarChar(255)
  phone                String    @db.VarChar(50)
  nationality          String    @db.VarChar(100)
  date_of_birth        DateTime? @db.Date
  passport_number      String?   @unique @db.VarChar(100)
  passport_issue_date  DateTime? @db.Date
  passport_expiry_date DateTime? @db.Date
  issue_country        String?   @db.VarChar(100)
  is_vip               Boolean   @default(false)
  status               String    @default("active") @db.VarChar(20)
  notes                String?   @db.Text
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  flight_bookings    FlightBooking[]
  hotel_bookings     HotelBooking[]
  transfers          Transfer[]
  visa_applications  VisaApplication[]
  package_bookings   PackageBooking[]
  group_bookings     GroupBooking[]     @relation("group_leader")
  group_members      GroupMember[]
  invoices           Invoice[]
  payments           Payment[]
  quotations         Quotation[]
  leads              Lead[]             @relation("lead_converted")
  insurance_policies InsurancePolicy[]
  commission_ledger  CommissionLedger[]

  @@index([passport_number])
  @@index([status])
  @@index([nationality])
  @@map("customers")
}

// ============================================
// STAFF
// ============================================

model Staff {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @unique @db.Uuid
  employee_id String    @unique @db.VarChar(100)
  designation String?   @db.VarChar(100)
  department  String?   @db.VarChar(100)
  join_date   DateTime? @db.Date
  salary      Decimal?  @db.Decimal(12, 2)
  rating      Decimal?  @db.Decimal(3, 2)
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  user              User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  flight_bookings   FlightBooking[]
  visa_applications VisaApplication[]  @relation("visa_officer")
  leads             Lead[]             @relation("lead_assigned")
  commission_ledger CommissionLedger[] @relation("agent_commission")
  staff_schedules   StaffSchedule[]

  @@map("staff")
}

// ============================================
// FLIGHTS
// ============================================

model Airline {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String  @unique @db.VarChar(255)
  code     String  @unique @db.VarChar(10)
  logo_url String? @db.Text

  flight_bookings FlightBooking[]

  @@map("airlines")
}

model FlightBooking {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_reference String   @unique @db.VarChar(50)
  pnr               String   @unique @db.VarChar(20)
  customer_id       String?  @db.Uuid
  staff_id          String?  @db.Uuid
  airline_id        String?  @db.Uuid
  route_from        String   @db.VarChar(10)
  route_to          String   @db.VarChar(10)
  travel_date       DateTime @db.Date
  class             String   @default("Economy") @db.VarChar(20)
  ticket_number     String?  @db.VarChar(100)
  fare              Decimal  @db.Decimal(10, 2)
  tax               Decimal  @default(0) @db.Decimal(10, 2)
  service_charge    Decimal  @default(0) @db.Decimal(10, 2)
  total_fare        Decimal  @db.Decimal(10, 2)
  status            String   @default("pending") @db.VarChar(20)
  booking_date      DateTime @default(now()) @db.Date
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  customer Customer? @relation(fields: [customer_id], references: [id])
  staff    Staff?    @relation(fields: [staff_id], references: [id])
  airline  Airline?  @relation(fields: [airline_id], references: [id])

  @@index([pnr])
  @@index([customer_id])
  @@index([status])
  @@map("flight_bookings")
}

// ============================================
// HOTELS
// ============================================

model HotelPartner {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String   @db.VarChar(255)
  location      String?  @db.VarChar(255)
  rating        Decimal? @db.Decimal(3, 2)
  reviews_count Int      @default(0)
  amenities     Json?    @db.JsonB
  email         String?  @db.VarChar(255)
  phone         String?  @db.VarChar(50)
  website       String?  @db.VarChar(255)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  hotel_bookings HotelBooking[]

  @@map("hotel_partners")
}

model RoomType {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String  @unique @db.VarChar(100)
  description String? @db.Text
  icon        String? @db.VarChar(50)

  hotel_bookings HotelBooking[]

  @@map("room_types")
}

model HotelBooking {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_reference String   @unique @db.VarChar(50)
  customer_id       String?  @db.Uuid
  hotel_partner_id  String?  @db.Uuid
  room_type_id      String?  @db.Uuid
  check_in          DateTime @db.Date
  check_out         DateTime @db.Date
  rooms             Int      @default(1)
  rate_per_night    Decimal  @db.Decimal(10, 2)
  total             Decimal  @db.Decimal(10, 2)
  status            String   @default("tentative") @db.VarChar(20)
  voucher_issued    Boolean  @default(false)
  voucher_id        String?  @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  customer      Customer?     @relation(fields: [customer_id], references: [id])
  hotel_partner HotelPartner? @relation(fields: [hotel_partner_id], references: [id])
  room_type     RoomType?     @relation(fields: [room_type_id], references: [id])
  voucher       Voucher?      @relation("hotel_booking_voucher")

  @@index([customer_id])
  @@index([status])
  @@map("hotel_bookings")
}

model Voucher {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id     String   @unique @db.Uuid
  voucher_number String   @unique @db.VarChar(50)
  issued_at      DateTime @default(now()) @db.Timestamptz(6)
  issued_by      String?  @db.Uuid
  pdf_url        String?  @db.Text
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  booking HotelBooking @relation("hotel_booking_voucher", fields: [booking_id], references: [id])
  issuer  User?        @relation("voucher_issued_by", fields: [issued_by], references: [id])

  @@map("vouchers")
}

// ============================================
// TRANSPORT / TRANSFERS
// ============================================

model TransferType {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String  @unique @db.VarChar(50)
  description String? @db.Text

  transfers Transfer[]

  @@map("transfer_types")
}

model Transfer {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_reference String   @unique @db.VarChar(50)
  customer_id       String?  @db.Uuid
  vehicle_id        String?  @db.Uuid
  driver_id         String?  @db.Uuid
  transfer_type_id  String?  @db.Uuid
  pickup_location   String   @db.VarChar(255)
  dropoff_location  String   @db.VarChar(255)
  date_time         DateTime @db.Timestamptz(6)
  pax               Int      @default(1)
  distance_km       Decimal? @db.Decimal(8, 2)
  luggage_count     Int      @default(0)
  cost              Decimal  @db.Decimal(10, 2)
  currency          String   @default("OMR") @db.VarChar(10)
  payment_status    String   @default("pending") @db.VarChar(20)
  status            String   @default("assigned") @db.VarChar(20)
  notes             String?  @db.Text
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  customer      Customer?     @relation(fields: [customer_id], references: [id])
  vehicle       Vehicle?      @relation(fields: [vehicle_id], references: [id])
  driver        Driver?       @relation(fields: [driver_id], references: [id])
  transfer_type TransferType? @relation(fields: [transfer_type_id], references: [id])

  @@index([customer_id])
  @@index([driver_id])
  @@index([status])
  @@map("transfers")
}

model Vehicle {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plate_number        String    @unique @db.VarChar(50)
  model               String    @db.VarChar(255)
  type                String    @db.VarChar(50)
  capacity            Int
  current_driver_id   String?   @unique @db.Uuid
  status              String    @default("unassigned") @db.VarChar(50)
  mileage_km          Decimal?  @default(0) @db.Decimal(10, 2)
  fuel_type           String?   @db.VarChar(50)
  last_service_date   DateTime? @db.Date
  next_service_due    DateTime? @db.Date
  insurance_expiry    DateTime? @db.Date
  registration_expiry DateTime? @db.Date
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  driver           Driver?          @relation("vehicle_driver", fields: [current_driver_id], references: [id])
  transfers        Transfer[]
  maintenance_logs MaintenanceLog[]

  @@index([status])
  @@map("vehicles")
}

model Driver {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name      String    @db.VarChar(255)
  phone          String    @db.VarChar(50)
  license_number String?   @unique @db.VarChar(100)
  license_expiry DateTime? @db.Date
  vehicle_id     String?   @db.Uuid
  status         String    @default("available") @db.VarChar(50)
  rating         Decimal?  @default(0) @db.Decimal(3, 2)
  total_trips    Int       @default(0)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  vehicle          Vehicle?         @relation("vehicle_driver")
  transfers        Transfer[]
  maintenance_logs MaintenanceLog[]

  @@index([status])
  @@map("drivers")
}

model MaintenanceLog {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicle_id     String    @db.Uuid
  driver_id      String?   @db.Uuid
  type           String    @db.VarChar(50)
  status         String    @default("scheduled") @db.VarChar(50)
  description    String?   @db.Text
  cost           Decimal?  @db.Decimal(10, 2)
  garage_name    String?   @db.VarChar(255)
  scheduled_date DateTime? @db.Date
  completed_date DateTime? @db.Date
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  vehicle Vehicle @relation(fields: [vehicle_id], references: [id])
  driver  Driver? @relation(fields: [driver_id], references: [id])

  @@index([vehicle_id])
  @@index([status])
  @@map("maintenance_logs")
}

// ============================================
// VISA
// ============================================

model VisaType {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String  @unique @db.VarChar(100)
  description String? @db.Text

  visa_applications VisaApplication[]

  @@map("visa_types")
}

model Destination {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String  @unique @db.VarChar(255)
  country      String  @db.VarChar(100)
  embassy_city String? @db.VarChar(100)

  visa_applications VisaApplication[]

  @@map("destinations")
}

model VisaApplication {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_number String   @unique @db.VarChar(50)
  customer_id        String   @db.Uuid
  visa_type_id       String?  @db.Uuid
  destination_id     String?  @db.Uuid
  officer_id         String?  @db.Uuid
  passport_number    String   @db.VarChar(100)
  nationality        String   @db.VarChar(100)
  applied_date       DateTime @default(now()) @db.Date
  status             String   @default("submitted") @db.VarChar(50)
  visa_fee           Decimal  @default(0) @db.Decimal(10, 2)
  service_charge     Decimal  @default(0) @db.Decimal(10, 2)
  total_fee          Decimal  @default(0) @db.Decimal(10, 2)
  notes              String?  @db.Text
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  customer                 Customer                @relation(fields: [customer_id], references: [id])
  visa_type                VisaType?               @relation(fields: [visa_type_id], references: [id])
  destination              Destination?            @relation(fields: [destination_id], references: [id])
  officer                  Staff?                  @relation("visa_officer", fields: [officer_id], references: [id])
  visa_document_checklists VisaDocumentChecklist[]

  @@index([customer_id])
  @@index([status])
  @@map("visa_applications")
}

model VisaDocumentChecklist {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visa_application_id String  @db.Uuid
  name                String  @db.VarChar(255)
  is_required         Boolean @default(true)
  is_uploaded         Boolean @default(false)
  document_id         String? @db.Uuid

  visa_application VisaApplication @relation(fields: [visa_application_id], references: [id], onDelete: Cascade)
  document         Document?       @relation(fields: [document_id], references: [id])

  @@map("visa_document_checklist")
}

// ============================================
// PACKAGES / TOURS
// ============================================

model PackageCategory {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String  @unique @db.VarChar(100)
  description String? @db.Text

  packages Package[]

  @@map("package_categories")
}

model Package {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String   @db.VarChar(255)
  category_id   String?  @db.Uuid
  description   String?  @db.Text
  inclusions    Json?    @db.JsonB
  exclusions    Json?    @db.JsonB
  base_price    Decimal  @db.Decimal(10, 2)
  duration_days Int?
  max_pax       Int?
  image_url     String?  @db.Text
  status        String   @default("draft") @db.VarChar(20)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  category         PackageCategory? @relation(fields: [category_id], references: [id])
  package_bookings PackageBooking[]
  group_bookings   GroupBooking[]

  @@map("packages")
}

model PackageBooking {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_reference String    @unique @db.VarChar(50)
  package_id        String?   @db.Uuid
  customer_id       String?   @db.Uuid
  pax               Int
  total_amount      Decimal   @db.Decimal(10, 2)
  status            String    @default("pending") @db.VarChar(20)
  travel_date       DateTime? @db.Date
  created_at        DateTime  @default(now()) @db.Timestamptz(6)

  package  Package?  @relation(fields: [package_id], references: [id])
  customer Customer? @relation(fields: [customer_id], references: [id])

  @@map("package_bookings")
}

// ============================================
// ITINERARIES
// ============================================

model Itinerary {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id   String?  @db.Uuid
  booking_type String?  @db.VarChar(50)
  title        String   @db.VarChar(255)
  status       String   @default("draft") @db.VarChar(20)
  total_cost   Decimal  @default(0) @db.Decimal(12, 2)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  itinerary_days ItineraryDay[]

  @@map("itineraries")
}

model ItineraryDay {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itinerary_id String    @db.Uuid
  day_number   Int
  date         DateTime? @db.Date
  title        String?   @db.VarChar(255)
  description  String?   @db.Text
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  itinerary  Itinerary  @relation(fields: [itinerary_id], references: [id], onDelete: Cascade)
  activities Activity[]

  @@map("itinerary_days")
}

model Activity {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itinerary_day_id String   @db.Uuid
  type             String   @db.VarChar(50)
  title            String   @db.VarChar(255)
  description      String?  @db.Text
  start_time       DateTime? @db.Timestamptz(6)
  end_time         DateTime? @db.Timestamptz(6)
  location         String?  @db.VarChar(255)
  cost             Decimal  @default(0) @db.Decimal(10, 2)
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  itinerary_day ItineraryDay @relation(fields: [itinerary_day_id], references: [id], onDelete: Cascade)

  @@map("activities")
}

// ============================================
// GROUP BOOKINGS
// ============================================

model GroupBooking {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_reference String    @unique @db.VarChar(50)
  group_name        String    @db.VarChar(255)
  leader_id         String?   @db.Uuid
  package_id        String?   @db.Uuid
  total_pax         Int
  total_amount      Decimal   @db.Decimal(12, 2)
  status            String    @default("pending") @db.VarChar(20)
  travel_date       DateTime? @db.Date
  created_at        DateTime  @default(now()) @db.Timestamptz(6)

  leader        Customer?     @relation("group_leader", fields: [leader_id], references: [id])
  package       Package?      @relation(fields: [package_id], references: [id])
  group_members GroupMember[]

  @@map("group_bookings")
}

model GroupMember {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_booking_id String   @db.Uuid
  customer_id      String?  @db.Uuid
  is_leader        Boolean  @default(false)
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  group_booking GroupBooking @relation(fields: [group_booking_id], references: [id], onDelete: Cascade)
  customer      Customer?    @relation(fields: [customer_id], references: [id])

  @@map("group_members")
}

// ============================================
// INVOICES & PAYMENTS
// ============================================

model Invoice {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_number String    @unique @db.VarChar(50)
  customer_id    String?   @db.Uuid
  booking_id     String?   @db.Uuid
  booking_type   String?   @db.VarChar(50)
  issue_date     DateTime  @default(now()) @db.Date
  due_date       DateTime? @db.Date
  subtotal       Decimal   @db.Decimal(12, 2)
  tax_amount     Decimal   @default(0) @db.Decimal(12, 2)
  total_amount   Decimal   @db.Decimal(12, 2)
  status         String    @default("draft") @db.VarChar(20)
  notes          String?   @db.Text
  pdf_url        String?   @db.Text
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  customer      Customer?     @relation(fields: [customer_id], references: [id])
  invoice_items InvoiceItem[]
  payments      Payment[]

  @@index([customer_id])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_id  String  @db.Uuid
  description String  @db.VarChar(255)
  quantity    Int     @default(1)
  unit_price  Decimal @db.Decimal(10, 2)
  tax_rate    Decimal @default(0) @db.Decimal(5, 2)
  total       Decimal @db.Decimal(10, 2)

